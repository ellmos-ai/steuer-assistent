{
  "$schema": "ellmos-module-v1",
  "name": "steuer-assistent",
  "version": "0.2.0",
  "kind": "public-module",
  "visibility": "public",
  "publish_status": "github-public",
  "publish_note": "Nutzerentscheidung D-20260723-020: Veröffentlichung. Rechtsgutachten 2026-07-23 (RECHTSPRUEFUNG_OEFFENTLICHKEIT_2026-07-23.md, Ampel GRÜN unter Auflagen StBerG/RDG/UWG/BGB/DSGVO + Rechtsprechungsschicht + Fremdmodell-Review) umgesetzt; Auflagen (Status-Konsistenz, Haftungstext, Betriebsform-Trigger, Secret-Sweep) erfüllt vor Public-Schaltung.",
  "license": "MIT",
  "origin": {
    "type": "bach-extract",
    "bach_path": "agents/_experts/steuer/",
    "extraction_date": "2026-06-22"
  },
  "capabilities": [
    "belege-erfassen",
    "werbungskosten-aggregation",
    "private-arbeitsunterlage-export"
  ],
  "entrypoints": {
    "python_api": "steuer_assistent.core.SteuerAssistent",
    "cli": "steuer_assistent.cli"
  },
  "storage": {
    "type": "sqlite",
    "default_path": "%USERPROFILE%\\.steuer-assistent\\steuer.db",
    "env_override": "STEUER_ASSISTENT_DB",
    "tables": ["belege", "beleg_sequences", "werbungskosten_kategorien", "export_runs"]
  },
  "boundaries": {
    "net": "none",
    "paths": ["user_home/**"],
    "prohibited": ["bach.db", "BACH-Laufzeit", "Netzwerkzugriff", "GUI"]
  },
  "update": {
    "method": "local-directory",
    "repo": "https://github.com/ellmos-ai/steuer-assistent",
    "status": "github-public"
  },
  "wiring": {
    "provides": ["steuer_beleg", "private_steuer_arbeitsunterlage"],
    "consumes": []
  }
}
